{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "call-in",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "call-in.bordeauxjs.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./.selfhost-assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/present/pdf-viewer",
      "/present/pdf-viewer.html",
      "/new",
      "/new/*",
      "/en/new",
      "/en/new/*"
    ]
  },
  "vars": {
    "ROOM_ID": "default",
    "TURNSTILE_REQUIRED": "false",
    "ALLOWED_ORIGINS": "",
    "ADMIN_TOKEN_SHA256": "",
    "MODERATOR_TOKEN_SHA256": ""
  },
  "ratelimits": [{ "name": "CREATE_ATTEMPTS", "namespace_id": "1832465910", "simple": { "limit": 4, "period": 60 } }],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_SESSION",
        "class_name": "LiveSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LiveSession"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
